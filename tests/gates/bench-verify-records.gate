# tests/gates/bench-verify-records.gate
# No hosted step: the offline evidence-integrity check (aien-architecture#233 lane P2).
# 'cargo run --release --bin bench_verify_records -- records artifacts tests/fixtures/records/good'
# validates aien-bench-record/1 records and SHA256SUMS bundles; any defect line is a FAIL.
# Needs sibling ../canonical-branch-native-runtime (same crate as the other gates).
gate: BENCH-VERIFY-RECORDS
manifest_version: 2
owner: benchmarks
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - src/
  - records/
  - artifacts/
  - tests/fixtures/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["verify-records"]
expects:
  exit: 0
  observe: ["record_defects == 0"]
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine
